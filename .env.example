# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=scheme_db
POSTGRES_PORT=5432

# Application Settings
ENVIRONMENT=development
PROJECT_NAME="AI-Driven Scheme Matching for Marginalized Entrepreneurs"
BACKEND_PORT=8000
FRONTEND_PORT=3000

# CORS
CORS_ORIGINS=http://localhost:3000

# Next.js Public Settings
NEXT_PUBLIC_API_URL=http://localhost:8000

# AI Agent (optional — Sahayak works fully offline without these)
# When set, the agent uses the LLM to phrase its verified tool answers conversationally.
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=...
# AGENT_LLM_MODEL=gpt-4o-mini
